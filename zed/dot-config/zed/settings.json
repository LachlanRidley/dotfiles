// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette
{
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "indent_guides": {
    "background_coloring": "disabled",
    "enabled": false,
  },
  "minimap": {
    "show": "never",
  },
  "gutter": {
    "line_numbers": true,
  },
  "show_wrap_guides": true,
    "sidebar_side": "right",
    "dock": "right",
    "default_profile": "write",
    "default_model": {
      "provider": "anthropic",
      "model": "claude-haiku-4-5-latest",
      "enable_thinking": false,
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "helix_mode": true,
  "preferred_line_length": 111,
  "soft_wrap": "preferred_line_length",
  "git_panel": {
    "dock": "left",
    "tree_view": false,
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Monokai Pro (CE)",
  },
  "buffer_font_weight": 500.0,
  "buffer_font_family": "Fira Code",
  "title_bar": {
    "show_sign_in": false,
  },
  "disable_ai": true,
  "terminal": {
    "shell": {
      "with_arguments": {
        "program": "/opt/homebrew/bin/fish",
        "args": ["--login", "--interactive"],
      },
    },
  },
  "languages": {
    "Python": {
      "language_servers": ["ty", "ruff", "!basedpyright"],
    },
  },
  "vim_mode": false,
  "buffer_line_height": "comfortable",
  "relative_line_numbers": "disabled",
  "ui_font_size": 16,
  "buffer_font_size": 12.5,
}
