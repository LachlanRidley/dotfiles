#!/bin/sh

if ! [ -e '/etc/1password/custom_allowed_browsers' ]
then
  sudo mkdir -p /etc/1password

  printf "# This file, when placed into /etc/1password/custom_allowed_browsers will allow for
# custom browsers to be defined that can work with 1Password for Linux's browser extension
# integration.
#
# 1Password for Linux custom browser allowlist
#
# To add a browser here, add the filename of the browser. Multiple can be seperated by a \`\n\`.
# Any lines starting with \`#\` will be ignored.
#
# Example:
#
# vivaldi-bin
# opera
#
" | sudo tee -a /etc/1password/custom_allowed_browsers > /dev/null
fi

if ! sudo grep librewolf /etc/1password/custom_allowed_browsers -q
then
  echo librewolf | sudo tee -a /etc/1password/custom_allowed_browsers > /dev/null
fi
